# index-srv 部署变量（docker compose 会自动读取同目录下的 .env）
# 复制为 .env 后按需修改：cp .env.example .env

# 宿主机监听端口
INDEX_SRV_PORT=8080

# 监听地址：127.0.0.1 仅本机可访问；0.0.0.0 对外暴露（建议配合反向代理与访问控制）
INDEX_SRV_BIND=127.0.0.1

# 镜像标签
INDEX_SRV_TAG=latest

# 服务密钥：非空时，写操作（POST/PUT/PATCH/DELETE）需携带它的 SHA-256 摘要（x-service-digest），
# 界面上点击权限组件即可提升为 super；未设置时面板只读（权限固定 3 user，无法提升）。
# 服务启动时只读一次，内存仅保留摘要；生成方式：openssl rand -hex 24
INDEX_SRV_SECRET=

# 日志级别：debug / info / warn / error
INDEX_SRV_LOG_LEVEL=info

# 容器时区
TZ=Asia/Shanghai
